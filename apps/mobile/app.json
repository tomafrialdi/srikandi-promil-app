{
  "expo": {
    "name": "srikandi-promil",
    "slug": "srikandi-promil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "srikandipromil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.gridlova.srikandi-promil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gridlova.srikandipromil",
      "permissions": [
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_MENSTRUATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C13D68",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Srikandi Promil needs access to your photos so you can choose a profile picture.",
          "cameraPermission": "Srikandi Promil needs the camera so you can take a profile picture."
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Srikandi Promil reads your basal body temperature and cycle data from Apple Health to keep your fertility predictions up to date.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0cc14b7c-8e22-425a-a540-32ad785300f9"
      }
    },
    "owner": "gridlova"
  }
}
