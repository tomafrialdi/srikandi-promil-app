# Copy to .env.local (git-ignored) and fill in.
# Local: run `supabase status` in the repo root. On a physical device replace
# 127.0.0.1 with your Mac's LAN IP (e.g. http://192.168.1.10:54321).
# Cloud: Project Settings → API (the anon/publishable key is safe to ship in the app).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ImageKit (profile photos). Same values as the console's VITE_IMAGEKIT_* (public key only, never the private key).
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=
